{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yinjie",
  "version": "0.1.0",
  "identifier": "com.yinjie.runtime",
  "build": {
    "beforeDevCommand": "pnpm --dir ../app dev",
    "beforeBuildCommand": "YINJIE_APP_BUILD_BASE=relative pnpm --dir ../app build",
    "devUrl": "http://127.0.0.1:5180",
    "frontendDist": "../../app/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Yinjie",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 760,
        "transparent": false,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "externalBin": [],
    "shortDescription": "Yinjie desktop runtime shell",
    "longDescription": "Yinjie desktop shell — Tauri-based runtime that loads the Yinjie web app and bridges native window / tray / file save / locale capabilities. Frontend assets are shared with the iOS / Android / Web clients.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "providerShortName": null,
      "frameworks": [],
      "exceptionDomain": "",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      },
      "resources": [
        "zh-Hans.lproj/InfoPlist.strings",
        "en.lproj/InfoPlist.strings",
        "ja.lproj/InfoPlist.strings",
        "ko.lproj/InfoPlist.strings"
      ]
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": []
    }
  }
}
