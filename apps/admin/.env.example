# 仅本地开发使用：用于自动填充管理后台密钥
VITE_ADMIN_SECRET=

# 注意：multi-world 部署下，admin 的 apiBaseUrl 必须由 cloud-console "进入后台"
# 通过 hash bootstrap 注入到 runtime store。不要在这里写死 VITE_API_BASE /
# VITE_CORE_API_BASE_URL —— 它们会成为 runtime 缺失时的静默 fallback，让"撞错
# world child / 撞老 dev :3000"症状不可见。
# 单租户 dev 调试可以放到 .env.local（git 忽略）：
#   VITE_API_BASE=http://localhost:3000/api
#   VITE_CORE_API_BASE_URL=http://localhost:3000
