# =============================================================================
# LLM Provider (BYOK — Bring Your Own Key)
# =============================================================================
# Enclave talks to any OpenAI-compatible chat-completions gateway.
# Pick ONE of the templates below, paste your key into DEEPSEEK_API_KEY (the
# variable name is historical — it is the generic gateway key), and you're done.
#
# Variables:
#   OPENAI_BASE_URL  — gateway base URL (must end before /chat/completions)
#   DEEPSEEK_API_KEY — your gateway key (despite the name, works for any provider)
#   AI_MODEL         — model id understood by the gateway above
#
# For image reading you need a vision-capable model (e.g. gpt-4o-mini,
# claude-3-5-sonnet, gemini-1.5-flash, qwen-vl-plus).
#
# --- Option A: DeepSeek (cheapest, recommended for China) -------------------
DEEPSEEK_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
#
# --- Option B: OpenRouter (recommended for international users) -------------
# One key, 100+ models, has free-tier models (e.g. meta-llama/llama-3.1-8b-instruct:free).
# Sign up at https://openrouter.ai/keys
# DEEPSEEK_API_KEY=sk-or-...xxxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openai/gpt-4o-mini
#
# --- Option C: Requesty (OpenAI-compatible gateway) -------------------------
# One key, 400+ models, provider/model naming (e.g. openai/gpt-4o-mini).
# Sign up at https://app.requesty.ai/api-keys
# DEEPSEEK_API_KEY=rqsty-sk-...xxxx
# OPENAI_BASE_URL=https://router.requesty.ai/v1
# AI_MODEL=openai/gpt-4o-mini
#
# --- Option D: Groq (free tier, fastest inference) --------------------------
# Sign up at https://console.groq.com/keys
# DEEPSEEK_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
#
# --- Option E: Together AI ($5 free signup credit) --------------------------
# Sign up at https://api.together.xyz/settings/api-keys
# DEEPSEEK_API_KEY=xxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct-Turbo
#
# --- Option F: OpenAI (official) --------------------------------------------
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
#
# --- Option G: Ollama (local, no API cost, no internet needed) --------------
# Install: https://ollama.com/  →  ollama pull llama3.1:8b
# DEEPSEEK_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=llama3.1:8b

# MiniMax Token Plan (NPC video/music generation in 视频号 / 朋友圈)
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com
# minimax /v1/lyrics_generation 开关；默认 true（tokenplan 已覆盖该端点）。
# 端点配额或调用失败时，会自动退回 AiOrchestrator (MiniMax-M2.7 → n1n) 兜底；
# 若端点持续异常想紧急关闭，把这里改成 false 即可，行为退化为只走 LLM 兜底。
MINIMAX_LYRICS_ENABLED=true
# Token Plan /v1/coding_plan/search 日额度软上限；撞 2056 时 quota service 自动
# markExhaustedToday 熔断。无官方公布额度，先保守 200/天。
MINIMAX_DAILY_LIMIT_WEB_SEARCH=200

# Server
ADMIN_SECRET=
# Required for wiki auth (register/login). Use a long random string in production.
JWT_SECRET=yinjie-dev-secret
PORT=3000
# Relative paths are resolved from the repository root.
DATABASE_PATH=./data/database.sqlite

# Remote deployment
CORS_ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5181,http://localhost:5182,http://localhost:5184,http://localhost:5173,http://127.0.0.1:5180,http://127.0.0.1:5181,http://127.0.0.1:5182,http://127.0.0.1:5184,http://127.0.0.1:5173
PUBLIC_API_BASE_URL=http://localhost:3000

# Encrypts per-owner custom API keys on the server.
# Use a long random string in production.
USER_API_KEY_ENCRYPTION_SECRET=

# Email verification (login/register via email code).
# 留空 SMTP_HOST 时验证码会打印到服务端日志（dev mock 模式），凭证就绪后填入即真实发送。
#
# Wiki 邮件按收件人邮箱域名分流（与 cloud-api 一致）：
#   - 海外域名（gmail/outlook/yahoo/icloud/proton/yandex/naver/kakao 等 31 个）→ 走 SMTP_OVERSEAS_*
#   - 其他（qq/163/126/foxmail/企业邮箱 等）→ 走默认 SMTP_*
# 海外通道未配置时自动回落到默认通道，并打 warn 日志。
# 注：env 里写 KEY=（空字符串）等同于未配置，会触发 fallback 默认值；要清空就直接注释掉。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_PROXY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=隐界 Yinjie

# 海外邮箱通道（可选）。未配置则海外邮件回落到上面的默认通道。
# 典型组合：默认通道用阿里云 DirectMail（国内投递率好），海外通道用 Gmail/SES（海外投递率好）。
# from 地址独立配置，避免阿里云 DirectMail 因 envelope-from 不在已验证发信地址清单中被 5.7.0 拒收。
SMTP_OVERSEAS_HOST=
SMTP_OVERSEAS_PORT=465
SMTP_OVERSEAS_SECURE=true
SMTP_OVERSEAS_USER=
SMTP_OVERSEAS_PASS=
SMTP_OVERSEAS_PROXY=
MAIL_OVERSEAS_FROM_ADDRESS=
MAIL_OVERSEAS_FROM_NAME=

EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_RATE_LIMIT_WINDOW_SECONDS=3600
EMAIL_CODE_MAX_PER_WINDOW=5
